[Unit]
Description=Interrupt Robot Frontgate
After=network-online.target
Wants=network-online.target
After=sound.target pulseaudio.service pipewire-pulse.service
Wants=sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/HongTu/interrupt
ExecStart=%h/HongTu/interrupt/run_robot_frontgate_session.sh
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
