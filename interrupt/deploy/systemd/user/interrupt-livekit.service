[Unit]
Description=Interrupt Local LiveKit Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/HongTu/interrupt
ExecStart=%h/HongTu/interrupt/run_livekit_server.sh
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
