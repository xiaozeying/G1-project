LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
GEMINI_API_KEY=your_api_key_here
# Prefer WSS_PROXY for Gemini realtime when LiveKit is on a local/LAN ws:// URL.
WSS_PROXY=http://<gemini-wss-proxy-host>:<port>
# If the robot should connect to the dev machine over LAN, expose LiveKit on all interfaces.
LIVEKIT_BIND_ADDRESS=0.0.0.0
# Replace with the current dev machine LAN IP when testing from the robot.
LIVEKIT_NODE_IP=<livekit-lan-ip>
INTERRUPT_AGENT_RUNTIME_MODE=online_full
INTERRUPT_AGENT_BACKEND=gemini_realtime
INTERRUPT_AGENT_LOCAL_TEXT_DECISION_MODE=prefer_tools
INTERRUPT_AGENT_LOCAL_TEXT_PROVIDER=ollama
INTERRUPT_AGENT_LOCAL_TEXT_BASE_URL=http://127.0.0.1:11434
INTERRUPT_AGENT_LOCAL_TEXT_MODEL=qwen2.5:7b
INTERRUPT_ROBOT_OFFLINE_VLM_PROVIDER=ollama_native
INTERRUPT_ROBOT_OFFLINE_VLM_BASE_URL=http://<dev-lan-ip>:11434/v1
INTERRUPT_ROBOT_OFFLINE_VLM_MODEL=gemma3:latest
INTERRUPT_INPUT_DEVICE=
INTERRUPT_OUTPUT_DEVICE=
INTERRUPT_TEXT_MODE=0
INTERRUPT_RECORD=0
INTERRUPT_RTC_AUTO_REDISPATCH_ON_AGENT_DISCONNECT=1
INTERRUPT_RTC_REDISPATCH_COOLDOWN_S=8
INTERRUPT_RTC_AGENT_ABSENCE_CHECK_INTERVAL_S=20
INTERRUPT_ASSISTANT_AUDIO_MODE=transport_only
INTERRUPT_LOCAL_TOOL_ACK_AUDIO_MODE=transport_only
INTERRUPT_RTC_SUBSCRIBE_AUDIO=1
INTERRUPT_WAKE_WORD_FACTORY=
INTERRUPT_FRONTGATE_SESSION_COMMAND=
INTERRUPT_FRONTGATE_SESSION_TIMEOUT=0
INTERRUPT_MCP_STDIO_COMMAND=
INTERRUPT_MCP_HTTP_URLS=
